# ==========================================
# 1. Environment & Credentials (CRITICAL)
# ==========================================
.env
.env.*
!.env.example
/storage/*.key
auth.json

# ==========================================
# 2. Dependencies & Package Managers
# ==========================================
/vendor/
/node_modules/
npm-debug.log
yarn-error.log

# ==========================================
# 3. Build & Compiled Assets
# ==========================================
/public/build
/public/hot
/public/storage

# ==========================================
# 4. Storage, Cache, Databases & Logs
# ==========================================
/.phpunit.cache
.phpunit.result.cache
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/uploads/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*.log
/database/*.sqlite
/database/*.sqlite-journal

# ==========================================
# 5. IDE, Editor & Environment Tools
# ==========================================
/.fleet
/.idea
/.vscode
Homestead.json
Homestead.yaml

# ==========================================
# 6. Operating System Files
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# 7. Hardware & Microcontroller Artifacts
# ==========================================
.pio/
.clang-format
*.bin
*.hex
*.elf